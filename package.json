{
  "name": "e-ink-like-epub-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run && node --test scripts/android-benchmark-report.node-test.mjs",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:compat": "npm run build && playwright test --config=playwright.compat.config.ts",
    "test:responsive": "npm run build && playwright test --config=playwright.responsive.config.ts",
    "test:a11y": "npm run build && playwright test --config=playwright.a11y.config.ts",
    "test:visual": "npm run build && playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "npm run build && cross-env UPDATE_VISUAL_REFERENCES=1 playwright test --config=playwright.visual.config.ts",
    "benchmark:web": "playwright test --config=playwright.benchmark.config.ts",
    "benchmark:web:build": "npm run build && npm run benchmark:web",
    "benchmark:android": "node scripts/run-android-benchmark.mjs",
    "benchmark:android:assemble": "node scripts/run-android-benchmark.mjs --assemble",
    "benchmark:android:report": "node scripts/android-benchmark-report.mjs",
    "check": "npm run lint && npm run type-check && npm test",
    "cap:sync": "next build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:dev:sync": "cross-env CAP_DEV=true npx cap sync android",
    "android:dev": "cross-env CAP_DEV=true next dev -H 0.0.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "epubjs": "^0.3.93",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.8.13"
    },
    "next": {
      "sharp": "0.35.3"
    }
  }
}
